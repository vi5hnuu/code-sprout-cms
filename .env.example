# Copy to .env for local runs. Values match docker-compose.dev.yml.

HTTP_ADDR=:9300
LOG_LEVEL=debug
# Set to CF-Connecting-IP behind Cloudflare; leave empty when clients connect directly.
TRUSTED_CLIENT_IP_HEADER=
CORS_ORIGINS=http://localhost:4300

# Primary takes writes; replica serves /v1/public reads. In dev both point at the same server.
DATABASE_URL=postgres://sprout:sprout@localhost:5442/sprout?sslmode=disable
DATABASE_REPLICA_URL=postgres://sprout:sprout@localhost:5442/sprout?sslmode=disable
DATABASE_MAX_CONNS=40

REDIS_ADDR=localhost:6389
REDIS_PASSWORD=

# Generic auth service (IdeaProjects/auth). Tokens are verified locally against its JWKS.
# The auth instance must list AUTH_AUDIENCE in its AUTH_JWT_ALLOWED_AUDIENCES (deploy config only).
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
AUTH_ISSUER=https://auth.laxmi.solutions
AUTH_AUDIENCE=code-sprout-cms

# S3-compatible object storage (SeaweedFS in dev; R2/S3 in production).
# Public bucket: article images and videos, served through the CDN.
# Private bucket: test sets, checkers and archived revisions; reachable only via presigned URLs.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=sprout
STORAGE_SECRET_KEY=sprout-secret
STORAGE_PUBLIC_BUCKET=sprout-public
STORAGE_PRIVATE_BUCKET=sprout-private
# Base URL readers fetch public objects from (the CDN in production).
STORAGE_PUBLIC_BASE_URL=http://localhost:9010/sprout-public

# ls-judge (WebstormProjects/ls-judge). The CMS uses one judge account: create it in the judge
# admin API on an unmetered plan and put its API key here. Leave JUDGE_URL empty to run without
# code execution (run/submit endpoints answer 503).
JUDGE_URL=http://localhost:8080
JUDGE_API_KEY=

# Meilisearch (docker-compose profile "search"). Empty URL = search answers 503.
SEARCH_URL=http://localhost:7710
SEARCH_API_KEY=sprout-dev-master-key
SEARCH_INDEX=content

# After a publish the worker refreshes caches and search engines. All optional.
# Next.js on-demand revalidation (apps/code-sprout /api/revalidate) and its shared secret.
WEB_REVALIDATE_URL=http://localhost:4300/api/revalidate
WEB_REVALIDATE_SECRET=dev-revalidate-secret
# Cloudflare purge-by-cache-tag (production only).
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Public site origin and IndexNow key (Bing/Yandex). The site serves /<key>.txt.
SITE_URL=http://localhost:4300
INDEXNOW_KEY=
