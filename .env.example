# Copy to .env for local runs. Values match docker-compose.dev.yml.

HTTP_ADDR=:9300
LOG_LEVEL=debug
# Set to CF-Connecting-IP behind Cloudflare; leave empty when clients connect directly.
TRUSTED_CLIENT_IP_HEADER=
CORS_ORIGINS=http://localhost:4300

# Primary takes writes; replica serves /v1/public reads. In dev both point at the same server.
DATABASE_URL=postgres://sprout:sprout@localhost:5442/sprout?sslmode=disable
DATABASE_REPLICA_URL=postgres://sprout:sprout@localhost:5442/sprout?sslmode=disable
DATABASE_MAX_CONNS=40

REDIS_ADDR=localhost:6389
REDIS_PASSWORD=

# Generic auth service (IdeaProjects/auth). Tokens are verified locally against its JWKS.
# The auth instance must list AUTH_AUDIENCE in its AUTH_JWT_ALLOWED_AUDIENCES (deploy config only).
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
AUTH_ISSUER=https://auth.laxmi.solutions
AUTH_AUDIENCE=code-sprout-cms
