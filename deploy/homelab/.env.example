# Code Sprout CMS homelab environment — the operator-facing knobs.
#
# WHERE THIS FILE LIVES:
#   • A copy of this file in the deploy folder (as ./env, never committed): references
#     WEB_REPO + the public domains the Caddy snippets need, and the compose-time
#     variables (ports, build args).
#   • /etc/code-sprout-cms/prod.env (root:root, 0600): the full runtime environment the
#     containers read via env_file (secrets, database URLs, AWS S3 credentials, auth
#     endpoints). ./setup.sh materialises this file on first run from prod.env.template,
#     generating fresh random secrets with openssl rand.
#
# This split matches every other service on the host (ls-judge, pdf-studio, chat-craft):
# operator-facing settings in the repo, machine secrets under /etc.

# ── repository that contains apps/code-sprout-cms (the Next.js web) ────────────────────────
# The web image is built with its Dockerfile; everything else is built from this repo.
WEB_REPO=/home/kvi5hnu/Desktop/laxmi-solutions-nextjs

# ── public URLs ────────────────────────────────────────────────────────────────────────────
PUBLIC_SCHEME=https
SITE_DOMAIN=code-sprout.laxmi.solutions
API_DOMAIN=code-sprout-api.laxmi.solutions
# The hostname the browser loads images and videos from. Set to the CloudFront (or other
# CDN) hostname that fronts the AWS public bucket. No Caddy routing is added for this
# domain — it lives entirely in AWS/CloudFront. Must match STORAGE_PUBLIC_BASE_URL's host
# in /etc/code-sprout-cms/prod.env; the Next.js image loader and the CSP are compiled
# against this origin.
MEDIA_DOMAIN=CHANGE_ME_cdn_hostname
# S3 endpoint the browser PUTs to with presigned URLs (regional S3, not CloudFront).
STORAGE_UPLOAD_ORIGIN=https://s3.ap-south-1.amazonaws.com
# The shared auth service's public hostname (ls-judge-auth), used as the JWT issuer.
AUTH_DOMAIN=ls-judge-auth.laxmi.solutions

# Google sign-in client ID. Reuse the one the shared auth already accepts (see
# /etc/ls-judge/auth.env). Compiled into the client bundle, so it is public.
GOOGLE_CLIENT_ID=753658365470-p4ueils7q596i2bcv21ml4atsisq67pc.apps.googleusercontent.com

# Optional: the YouTube channel the Code Sprout brand publishes as. Empty hides channel links.
YOUTUBE_CHANNEL_URL=

# Trusted platform fingerprint for the Android app's Credential Manager integration (empty
# off). Not used by the browser.
ANDROID_APP_CERT_SHA256=

# ── compose-time port overrides (optional) ────────────────────────────────────────────────
# Loopback-only ports on the host; the host Caddy proxies to them. Pick values that do not
# clash with other services on this host (see `ss -tlnp` or docker ps).
WEB_PORT=4410
API_PORT=4411
POSTGRES_PORT=5442
REDIS_PORT=6389
SEARCH_PORT=7710

# ── web build-time URL for prerender (loopback into the running API) ───────────────────────
# Deploy builds the web image with --network host after the API is healthy, so this is the
# host-side URL (API_PORT above).
WEB_BUILD_API_URL=http://127.0.0.1:4411

# Session cookie Secure flag: true in production (HTTPS). Set false for a plain-HTTP private
# deployment.
SESSION_COOKIE_SECURE=true
