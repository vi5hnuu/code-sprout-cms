# Code Sprout homelab settings. Copy to .env (never commit it) and replace every CHANGE_ME.
# Secrets: generate each with   openssl rand -hex 32   (hex is safe inside URLs).

# ── Where things are ─────────────────────────────────────────────────────────
# Host folder holding all data (databases, uploads, search index, auth keys, backups).
DATA_DIR=/srv/codesprout
# Checkouts the images are built from (absolute paths on this host).
WEB_REPO=/home/CHANGE_ME/laxmi-solutions-nextjs
AUTH_REPO=/home/CHANGE_ME/auth

# ── Public addresses (served by the host Caddy, see ./caddy) ─────────────────
PUBLIC_SCHEME=https
SITE_DOMAIN=codesprout.CHANGE_ME
MEDIA_DOMAIN=media.codesprout.CHANGE_ME
AUTH_DOMAIN=auth.codesprout.CHANGE_ME
# Session cookies are HTTPS-only. Set false only for a plain-HTTP deployment on a private
# network; never on the internet.
SESSION_COOKIE_SECURE=true

# Loopback ports the host Caddy proxies to (change only if they clash).
WEB_PORT=4410
API_PORT=4411
MEDIA_PORT=4412
AUTH_PORT=4413
# The web image build reads the API here to prerender static pages. Default is the API's
# loopback port above; on Docker Desktop use http://host.docker.internal:4411.
# WEB_BUILD_API_URL=http://127.0.0.1:4411

# ── Secrets (openssl rand -hex 32) ───────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MEILI_MASTER_KEY=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
AUTH_DB_ROOT_PASSWORD=CHANGE_ME
# Object storage credentials (setup.sh writes them into the storage config).
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
# Shared by the web server and the API: proves the web server's calls (reader addresses).
INTERNAL_PROXY_SECRET=CHANGE_ME
# Shared by the worker and the web server: authorises cache revalidation after publishing.
REVALIDATE_SECRET=CHANGE_ME

# ── Code judge (runs submissions and runnable code) ──────────────────────────
JUDGE_URL=https://runtimes.laxmi.solutions/api
JUDGE_API_KEY=CHANGE_ME

# ── Mail for sign-up verification and password reset (AWS SES) ───────────────
AUTH_MAIL_FROM=no-reply@laxmi.solutions
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# false keeps mails queued instead of sending them (e.g. before SES is set up).
AUTH_MAIL_ENABLED=true

# ── Optional ─────────────────────────────────────────────────────────────────
# Google sign-in (OAuth web client id); empty hides the button.
GOOGLE_CLIENT_ID=
# YouTube mirroring: API key, channel ids (comma-separated), and the Code Sprout handle that
# owns the videos (create that account first). Empty key = sync off.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=UCOKlu8uJGV0i3dL2ekv6NfQ
YOUTUBE_OWNER_HANDLE=
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@ccw-vishnu
# Search engines: IndexNow key (8-128 letters, digits or dashes); Cloudflare cache purge.
INDEXNOW_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Android app links (SHA-256 of the release signing certificate).
ANDROID_APP_CERT_SHA256=
LOG_LEVEL=info
AUTH_JAVA_OPTS=-Xmx512m
# How many daily backups backup.sh keeps.
BACKUP_KEEP_DAYS=14
