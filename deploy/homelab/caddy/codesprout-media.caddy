# Code Sprout media (object storage) — imported inside the site block for MEDIA_DOMAIN.
# Browsers upload here with presigned URLs and read public files. The Host header is passed
# through unchanged (Caddy's default): upload signatures are computed over it.

# Public files never change once written (their keys are content-addressed), so a found
# file is cached for a year. Only 200s: a 404 or 403 must not stick in browsers.
@public {
    method GET HEAD
    path /sprout-public/*
}
handle @public {
    # 4412 = MEDIA_PORT in .env
    reverse_proxy 127.0.0.1:4412 {
        @found status 200
        handle_response @found {
            # The backend headers are kept as they are; only caching is added.
            header Cache-Control "public, max-age=31536000, immutable"
            copy_response
        }
    }
}
handle {
    reverse_proxy 127.0.0.1:4412
}
