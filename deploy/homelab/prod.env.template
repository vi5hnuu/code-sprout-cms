# Template for /etc/code-sprout-cms/prod.env. ./setup.sh renders this file.
#   • __AUTO_SECRET__                     → openssl rand -hex 32  (fresh on first run)
#   • ${ALREADY_RESOLVED_VAR} references  → substituted with the value set earlier in this
#                                            file (simple sequential resolver; refer only
#                                            to variables already set above)
# The rendered file is installed to /etc/code-sprout-cms/prod.env (0600 root:root) and read
# by every container via env_file. Re-running setup.sh never rotates secrets: values already
# present in the live file are kept.
#
# IMPORTANT: this file is read as a plain KEY=VALUE flat file by docker-compose's env_file.
# No shell expansion happens at runtime — references must be pre-resolved by setup.sh.

# ── logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── listen addresses (never on the public port) ──────────────────────────────
HTTP_ADDR=:9300
API_METRICS_ADDR=0.0.0.0:9311
WORKER_METRICS_ADDR=0.0.0.0:9312
TRUSTED_CLIENT_IP_HEADER=X-Real-IP

# ── proxy trust (web → api) ──────────────────────────────────────────────────
INTERNAL_PROXY_SECRET=__AUTO_SECRET__

# ── CORS: only the public site may call the API from a browser ──────────────
CORS_ORIGINS=https://code-sprout.laxmi.solutions

# ── Postgres (compose service `postgres`) ───────────────────────────────────
POSTGRES_PASSWORD=__AUTO_SECRET__
# The compose service `postgres` also reads these to initialise the DB on first boot.
POSTGRES_USER=sprout
POSTGRES_DB=sprout
# Fully-resolved URLs so no runtime shell expansion is needed.
DATABASE_URL=postgres://sprout:${POSTGRES_PASSWORD}@postgres:5432/sprout?sslmode=disable
DATABASE_REPLICA_URL=postgres://sprout:${POSTGRES_PASSWORD}@postgres:5432/sprout?sslmode=disable
DATABASE_MAX_CONNS=40
# For the one-shot migrate container (goose reads GOOSE_DBSTRING).
GOOSE_DBSTRING=postgres://sprout:${POSTGRES_PASSWORD}@postgres:5432/sprout?sslmode=disable

# ── Redis (compose service `redis`) ──────────────────────────────────────────
REDIS_PASSWORD=__AUTO_SECRET__
REDIS_ADDR=redis:6379

# ── shared auth (host systemd service ls-judge-auth on 8081) ─────────────────
AUTH_JWKS_URL=http://host.docker.internal:8081/.well-known/jwks.json
AUTH_ISSUER=https://ls-judge-auth.laxmi.solutions
AUTH_AUDIENCE=code-sprout-cms

# ── object storage (AWS S3, reusing the old code-sprout credentials) ─────────
# Access key / secret: same AWS account as the legacy /etc/code-sprout/prod.env.
# Bucket names and the reader-facing base URL are operator-provided — fill in after
# creating the buckets in the AWS console.
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=CHANGE_ME_aws_access_key
STORAGE_SECRET_KEY=CHANGE_ME_aws_secret_key
# Public bucket (images, videos): ACL public-read, fronted by a CDN. Create in AWS console
# (ap-south-1), enable CORS for the site origin, add a CloudFront distribution.
STORAGE_PUBLIC_BUCKET=CHANGE_ME_public_bucket
# Reader-facing origin for public objects — the CloudFront hostname (preferred) or the
# direct S3 origin. CMS asset URLs are built from this + the object key.
STORAGE_PUBLIC_BASE_URL=CHANGE_ME_https_cdn_origin
# Private bucket (test sets, checkers, archived revisions). Create in AWS console
# (ap-south-1, block all public access, versioning on, SSE-S3 default encryption).
STORAGE_PRIVATE_BUCKET=CHANGE_ME_private_bucket

# ── Meilisearch (compose service `meilisearch`) ──────────────────────────────
MEILI_MASTER_KEY=__AUTO_SECRET__
SEARCH_URL=http://meilisearch:7700
SEARCH_API_KEY=${MEILI_MASTER_KEY}
SEARCH_INDEX=content

# ── code judge (shared ls-judge; populate when a service account is minted) ──
JUDGE_URL=https://runtimes.laxmi.solutions/api
JUDGE_API_KEY=

# ── worker → web revalidation ────────────────────────────────────────────────
REVALIDATE_SECRET=__AUTO_SECRET__
WEB_REVALIDATE_URL=http://web:4410/api/revalidate
SITE_URL=https://code-sprout.laxmi.solutions

# ── search engines (optional) ────────────────────────────────────────────────
INDEXNOW_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ── video mirroring (optional) ───────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=UCOKlu8uJGV0i3dL2ekv6NfQ
YOUTUBE_OWNER_HANDLE=
YOUTUBE_EXCLUDED_PLAYLISTS=
YOUTUBE_SYNC_INTERVAL=15m
YOUTUBE_DAILY_QUOTA=5000
